# Environment variables for the SHAKOOR Integrated Solutions website.
# Copy to .env.local for local development and fill in real values there.
# Never commit real values. See ENVIRONMENT_SETUP.md for details.

# ── Public (embedded into the site at BUILD time) ─────────────────────────────
# Production URL, with https:// and no trailing slash.
# Used for canonical URLs, Open Graph links, sitemap.xml and robots.txt.
# Optional, but without it no sitemap is published.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Server-only (read at RUN time by /api/enquiry) ────────────────────────────
# Enquiry email delivery via Resend (https://resend.com).
# All three are required for the contact form to send email; if any is missing
# the form reports that enquiries are not connected (it never fakes success).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Inbox that receives enquiries. Comma-separate several addresses if needed.
ENQUIRY_TO_EMAIL=enquiries@your-company-domain.com
# Sender. Must be on a domain verified in your Resend account.
ENQUIRY_FROM_EMAIL="Shakoor Website <website@your-company-domain.com>"

# Optional: send visitors an automatic "we received your enquiry" email (true/false).
ENQUIRY_SEND_CONFIRMATION=false
