# Copy to .env.local and fill in. Never commit real values.

# Public production URL (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Enquiry email delivery via Resend (https://resend.com).
# The "from" address must be on a domain you have verified with Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
ENQUIRY_TO_EMAIL=enquiries@your-company-domain.com
ENQUIRY_FROM_EMAIL="Shakoor Website <website@your-company-domain.com>"

# Send an automatic "we received your enquiry" email to the visitor (true/false).
ENQUIRY_SEND_CONFIRMATION=false
